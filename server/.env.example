# Copy this file to ".env" and fill in your own values.

# MySQL connection (the database is created by database/schema.sql)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=careerlens_db

# Any long random string
JWT_SECRET=replace_this_with_a_long_random_string

PORT=5000

# Optional: real job listings from Adzuna (free keys at https://developer.adzuna.com/)
# Leave blank to use the sample jobs stored in the jobs table.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
